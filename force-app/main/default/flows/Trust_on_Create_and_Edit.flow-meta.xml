+ &quot; (&quot;+ TEXT({!$Record.Trust_Type__c})+&quot;) - &quot; + TEXT({!$Record.Trust_Status__c}) + &quot; &quot; + {!$Record.Internal_Account_Number__c}, 80),  LEFT({!$Record.Beneficiary__r.FirstName}+&quot; &quot;+ {!$Record.Beneficiary__r.MiddleName} + &quot; &quot; +{!$Record.Beneficiary__r.LastName} 
+ &quot; (&quot;+TEXT({!$Record.Trust_Type__c})+&quot;) - &quot;+ TEXT({!$Record.Trust_Status__c}) + &quot; &quot; + {!$Record.Internal_Account_Number__c}, 80))</expression>
