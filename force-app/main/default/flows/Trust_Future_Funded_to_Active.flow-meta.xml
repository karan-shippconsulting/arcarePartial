    <decisions>
        <name>Type_of_Trust_Future_Funded_Check</name>
        <label>Type of Trust/Future Funded Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Future_Funded_I_or_III</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>PriorValueStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Future Funded</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Trust_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>I</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Trust_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>III</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_I_or_III_Future_Funded_to_Active_Email</targetReference>
            </connector>
            <label>Future Funded I or III</label>
        </rules>
        <rules>
            <name>Future_Funded_II_or_IV</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>PriorValueStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Future Funded</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Trust_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>II</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Trust_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>IV</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SendIIorIVEmail</targetReference>
            </connector>
            <label>Future Funded II or IV</label>
        </rules>
    </decisions>
