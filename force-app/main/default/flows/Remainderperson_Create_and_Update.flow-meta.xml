    <environments>Default</environments>
    <formulas>
        <name>AccountFormula</name>
        <dataType>String</dataType>
        <expression>IF(!ISBLANK({!$Record.Remainder_Person_Contact__c}), {!$Record.Remainder_Person_Contact__r.AccountId}, {!$Record.Remainder_Person_Account__c})</expression>
    </formulas>
