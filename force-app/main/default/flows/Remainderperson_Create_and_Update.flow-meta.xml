        <name>NameFormula</name>
        <dataType>String</dataType>
        <expression>IF(!ISBLANK({!$Record.Remainder_Person_Contact__c}), {!$Record.Remainder_Person_Contact__r.FirstName} + &quot; &quot; + {!$Record.Remainder_Person_Contact__r.LastName} + &quot; RP - &quot; + TEXT({!$Record.Percent_of_Remaining_Funds__c}) + &quot;%&quot;,
{!$Record.Remainder_Person_Account__r.Name} +  &quot; RP - &quot; + TEXT({!$Record.Percent_of_Remaining_Funds__c}) + &quot;%&quot;)</expression>
    </formulas>
