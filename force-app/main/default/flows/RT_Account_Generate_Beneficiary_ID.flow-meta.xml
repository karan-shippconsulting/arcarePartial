    <assignments>
        <name>Increment_Tracker_Value</name>
        <label>Increment Tracker Value</label>
        <locationX>314</locationX>
        <locationY>731</locationY>
        <assignmentItems>
            <assignToReference>var_CurrentTracker</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Trust_Type_Counter</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Reset_Variables</name>
        <label>Reset Variables</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <assignmentItems>
            <assignToReference>var_CurrentTracker</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_TrustTypeCounterID</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_if_Account_is_MSA</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_if_Account_is_MSA</name>
        <label>Check if Account is MSA</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Increment_Tracker_Value</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Non_MSA_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Trust_Type__pc</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>MSA</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Retrieve_Trust_Type_Counter_for_Non_MSA</targetReference>
            </connector>
            <label>Non-MSA Account</label>
        </rules>
        <rules>
            <name>MSA_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Trust_Type__pc</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MSA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.MSA_Type__pc</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Retrieve_Trust_Type_Counter_for_MSA</targetReference>
            </connector>
            <label>MSA Account</label>
        </rules>
    </decisions>
    <description>Generates a unique ID for Accounts marked as beneficiaries (Is_Beneficiary__pc = True) based on Trust Type, beneficiary count, and account creation year. This ID is formatted according to specific rules and increments separate counters for each Trust Type to ensure unique numbering.</description>
    <environments>Default</environments>
    <formulas>
        <name>fml_Construct_Beneficiary_ID</name>
        <dataType>String</dataType>
        <expression>{!$Record.Trust_Type_Code__pc} &amp; LPAD(TEXT({!var_CurrentTracker}), 4, &quot;0&quot;) &amp; {!$Record.Year_Last_2_Digits__pc}</expression>
    </formulas>
    <interviewLabel>RT - Account - Generate Beneficiary ID {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RT - Account - Generate Beneficiary ID</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
