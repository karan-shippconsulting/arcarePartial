                <elementReference>Get_Related_Account.PersonGenderIdentity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Maritial_Status__c</field>
            <value>
                <elementReference>Get_Related_Account.Marital_Status__pc</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SuppliedEmail</field>
            <value>
                <elementReference>Get_Related_Account.PersonEmail</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SuppliedPhone</field>
            <value>
                <elementReference>Get_Related_Account.PersonMobilePhone</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
