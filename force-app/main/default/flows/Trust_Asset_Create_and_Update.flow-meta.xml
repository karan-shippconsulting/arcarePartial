<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <assignments>
        <name>Assign_Trust_and_Closing_ID</name>
        <label>Assign Trust and Closing ID</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>TrustID</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Trust__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ClosingID</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Closing__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_For_Closing_Trust</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_For_Closing_Trust</name>
        <label>Check For Closing/Trust</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Closing_on_Trust</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Trust</defaultConnectorLabel>
        <rules>
            <name>Closing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ClosingID</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Trust_on_Trust_Asset</targetReference>
            </connector>
            <label>Closing</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_Funeral_Plan</name>
        <label>Check for Funeral Plan</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Funeral_Plan</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Asset_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Funeral Plan</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Beneficiary</targetReference>
            </connector>
            <label>Funeral Plan</label>
        </rules>
    </decisions>
    <description>6/17/25: Added decision so can create from either Closing or Trust and the other one is updated.</description>
    <environments>Default</environments>
    <interviewLabel>Trust Asset - Create and Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Trust Asset - Create and Update</label>
    <processMetadataValues>
