    <decisions>
        <name>Check_Status_Changes</name>
        <label>Check Status Changes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Approved</targetReference>
            </connector>
            <label>Approved</label>
        </rules>
        <rules>
            <name>Rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Rejected</targetReference>
            </connector>
            <label>Rejected</label>
        </rules>
    </decisions>
    <description>2025-09-21 - Added Code to for Naming Convention.</description>
    <environments>Default</environments>
    <formulas>
        <name>DocumentNameFormula</name>
        <dataType>String</dataType>
        <expression>left(if(isblank({!$Record.File_Name__c}),{!Get_Content_Document_Link.ContentDocument.Title},{!$Record.File_Name__c})+&quot; &quot;+text(Month(datevalue({!$Record.createddate})))+&quot;/&quot;+text(Day(datevalue({!$Record.createddate})))+&quot;/&quot;+text(year(datevalue({!$Record.createddate}))),80)</expression>
    </formulas>
    <formulas>
        <name>EmailSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Document Approved: &quot;&amp;{!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>FilenameFormula</name>
        <dataType>String</dataType>
        <expression>if(isblank({!$Record.File_Name__c}),{!Get_Content_Document_Link.ContentDocument.Title},{!$Record.File_Name__c})</expression>
    </formulas>
    <formulas>
        <name>ParentRecordIDFormula</name>
        <dataType>String</dataType>
        <expression>if(AND(left({!$Record.ParentRecordId},3)=&apos;001&apos;,!isblank({!$Record.Account.PersonContactId})),{!$Record.Account.PersonContactId},{!$Record.ParentRecordId})</expression>
    </formulas>
    <formulas>
        <name>RejectedSubject</name>
        <dataType>String</dataType>
        <expression>&quot;The document &quot;&amp;{!$Record.Name}&amp;&quot; has been Rejected&quot;</expression>
    </formulas>
    <formulas>
        <name>RejectedTaskDescription</name>
        <dataType>String</dataType>
        <expression>&quot;Notice of Rejected Document:  &quot;&amp;{!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>WhoIDFormula</name>
        <dataType>String</dataType>
        <expression>if(AND(left({!$Record.ParentRecordId},3)=&apos;001&apos;,!isblank({!$Record.Account.PersonContactId})),{!$Record.Account.PersonContactId},
if(AND(isblank({!$Record.WhoId}),!isblank({!$Record.AccountId}),!isblank({!$Record.Account.PersonContactId})),{!$Record.Account.PersonContactId},
{!$Record.WhoId}))</expression>
    </formulas>
