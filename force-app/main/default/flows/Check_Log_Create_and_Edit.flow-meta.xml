<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <decisions>
        <name>Check_for_Trust</name>
        <label>Check for Trust</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Trust</defaultConnectorLabel>
        <rules>
            <name>Trust</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Trust__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Check_Log_w_Trust</targetReference>
            </connector>
            <label>Trust</label>
        </rules>
    </decisions>
    <description>4/15/26: Added Beneficiary Name text field to allow search by Beneficiary Name</description>
    <environments>Default</environments>
    <formulas>
        <name>BeneficiaryNameFormula</name>
        <dataType>String</dataType>
        <expression>{!$Record.Beneficiary__r.FirstName} + &quot; &quot; + {!$Record.Beneficiary__r.LastName}</expression>
    </formulas>
    <interviewLabel>Check Log - Create and Edit {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Check Log - Create and Edit</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Check_Log</name>
        <label>Update Check Log</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_for_Trust</targetReference>
        </connector>
        <inputAssignments>
            <field>Beneficiary_Name__c</field>
            <value>
                <elementReference>BeneficiaryNameFormula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Check_Log_w_Trust</name>
        <label>Update Check Log w/ Trust</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Alternate_Rep_Account__c</field>
            <value>
                <elementReference>$Record.Trust__r.Alternate_Representative__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Alternate_Rep_Contact__c</field>
            <value>
                <elementReference>$Record.Trust__r.Alternate_Representative_Contact__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Beneficiary__c</field>
            <value>
                <elementReference>$Record.Trust__r.Beneficiary__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Primary_Rep_Account__c</field>
            <value>
                <elementReference>$Record.Trust__r.Primary_Representative__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Primary_Rep_Contact__c</field>
            <value>
                <elementReference>$Record.Trust__r.Primary_Representative_Contact__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Check_Log</targetReference>
        </connector>
        <object>Check_Log__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
