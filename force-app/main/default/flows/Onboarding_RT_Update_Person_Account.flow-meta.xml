    <formulas>
        <name>fml_CombinedStreetAddress</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK({!$Record.Address_Line_1__c}),
    {!$Record.Address_Line_2__c},
    IF(
        ISBLANK({!$Record.Address_Line_2__c}),
        {!$Record.Address_Line_1__c},
        {!$Record.Address_Line_1__c} &amp; BR() &amp; {!$Record.Address_Line_2__c}
