<apex:page standardController="Account" extensions="pdfPageController" renderAs="pdf" applyHtmlTag="false" showHeader="false" readOnly="true" cache="true">
    <html>
        <head>
            <meta http-equiv="Content-Type" content="text/html;charset=UTF-8"/>
            <style type="text/css">
            
            @page {
            padding-top:80px;
            padding-bottom:80px;
            
            @top-left {
            content: element(header);
            }
            @bottom-center {
            content: element(footer);
            }
            }
            div.header {
            padding: 5px;
            padding-top:20px;
            padding-bottom:20px;
            position: running(header);
            }
            div.footer{
            margin-top:-80px;
            padding-top:20px;
            padding-bottom:20px;
            position: running(footer);
            text-align: center;
            }
            div.main{
                padding-top:20px;
            	padding-bottom:20px;
            }
            
            thead{
            display: table-header-group;
            }
            table {
            page-break-inside: avoid;
            -fs-table-paginate: paginate;
            }
            tr.noBorder td {
            border: 0;
            }
            
        </style>
        </head>
        <body>
            <div class="header">
                <img src="{!$Resource.Header}" width="100%" height="100%"/>
            </div>
            <div class="footer">
                <img src="{!$Resource.Footer}" width="330%" height="100%"/>
            </div>
            <div class="main">
                <apex:outputText value="{!pdfText}" escape="false"/> 
            </div>
            
        </body>
        
    </html>
</apex:page>