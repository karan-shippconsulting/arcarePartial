<apex:page standardController="Account" extensions="pdfPageController" renderAs="pdf" applyHtmlTag="false" showHeader="false" readOnly="true" cache="true">
    <html>
        <head>
            <meta http-equiv="Content-Type" content="text/html;charset=UTF-8"/>
            <style type="text/css">
            
            @page {
                size: 9.5in 4.125in;p
                padding:4px;
            
            @top-left {
            content: element(header);
            }
            @bottom-center {
            content: element(footer);
            }
            }
            div.header {
                padding: 5px;
                text-align: center;
                position: running(header);
            }
            div.footer{
                position: running(footer);
                text-align: center;
            }
            div.main{
                padding-top: 1.00in;
                padding-left: 3.46in;
                font-size: 8pt;
            }
            
            thead{
                display: table-header-group;
            }
            table {
                page-break-inside: avoid;
                -fs-table-paginate: paginate;
            }
            tr.noBorder td {
                border: 0;
            }
            
        </style>
        </head>
        <body>
            <!--<div class="header">
                <img src="{!$Resource.Header}" width="50%" height="100%"/>
            </div>-->
            <!--<div class="footer">
                <img src="{!$Resource.Footer}" width="150%" height="100%"/>
            </div>-->
            <div class="main">
                <apex:outputText value="{!pdfText}" escape="false"/> 
            </div>
        </body>
        
    </html>
</apex:page>