<apex:page controller="pdfPageControllerBulk" renderAs="pdf" applyHtmlTag="false" showHeader="false" readOnly="true" cache="true">
    <html>
        <head>
            <meta http-equiv="Content-Type" content="text/html;charset=UTF-8"/>
            <style>
                .page-break { 
                    page-break-after: always; 
                }
        @page {
            padding-top:100px;
            @top-center {
            content: element(header);
            }
            @bottom-left {
            content: element(footer);
            }
            }
            div.header {
            margin-top: 5px;
            position: running(header);
            }
            
            thead{
            display: table-header-group;
            }
            table {
            page-break-inside: avoid;
            -fs-table-paginate: paginate;
            }
            tr.noBorder td {
            border: 0;
            }
            

            </style>
        </head>
        <body>
        <div class="header">
                <table style="width:100%">
                    <tr style="width:100%">
                        <td style="width:80%;text-align: left;">
                        <apex:outputText value="{!$Label.Invoice_Address}" escape="false" />
                    </td>
                    <td style="width:20%">
                        <img src="{!$Resource.Arcare_INVOICE_LOGO}" width="175px" height="120px"/>
                    </td>
                    </tr>
                </table>
                
            </div>
            <apex:variable var="index" value="{!0}"/>
            <apex:repeat value="{!pdfText}" var="text">
                <div class="main">
                    <apex:outputText value="{!text}" escape="false"/>        
                </div>
                <apex:variable var="index" value="{!index+1}"/>
                <apex:outputPanel rendered="{!index != pdfText.size}">
                    <div class="page-break"></div> <!-- Page break except for the last record -->
                </apex:outputPanel>
            </apex:repeat>
        </body>
    </html>
</apex:page>