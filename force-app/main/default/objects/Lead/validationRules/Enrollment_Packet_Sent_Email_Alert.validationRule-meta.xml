<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Enrollment_Packet_Sent_Email_Alert</fullName>
    <active>true</active>
    <errorConditionFormula>TEXT(Status )=&quot;Enrollment Packet Sent&quot; &amp;&amp;  ISBLANK( Email )</errorConditionFormula>
    <errorDisplayField>Email</errorDisplayField>
    <errorMessage>This onboarding does not have a value on the Email field. To send the Enrollment Packet to the Beneficiary, a value must be entered.</errorMessage>
</ValidationRule>
