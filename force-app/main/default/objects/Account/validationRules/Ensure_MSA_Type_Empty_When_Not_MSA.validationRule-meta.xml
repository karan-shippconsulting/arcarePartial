<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Ensure_MSA_Type_Empty_When_Not_MSA</fullName>
    <active>true</active>
    <description>Validates that the MSA Type field is empty when Trust Type is not &apos;MSA&apos;.</description>
    <errorConditionFormula>AND(
  NOT(ISPICKVAL(Trust_Type__pc, &quot;MSA&quot;)),
  NOT(ISBLANK(TEXT(MSA_Type__pc)))
)</errorConditionFormula>
    <errorDisplayField>MSA_Type__pc</errorDisplayField>
    <errorMessage>MSA Type must be empty if Trust Type is not &apos;MSA&apos;.</errorMessage>
</ValidationRule>
