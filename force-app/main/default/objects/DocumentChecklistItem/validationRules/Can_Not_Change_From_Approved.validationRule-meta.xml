<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Can_Not_Change_From_Approved</fullName>
    <active>true</active>
    <errorConditionFormula>ischanged(Status)&amp;&amp;text(PriorValue(Status))=&quot;Approved&quot;&amp;&amp;text(Status)!=&quot;Approved&quot;&amp;&amp; $Profile.Name !=&quot;System Administrator&quot;</errorConditionFormula>
